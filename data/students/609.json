              "title": "伊吹的朋友！",
              "title_cn": "",
              "preview": "https://static.kivo.wiki/videos/students/%E4%B8%B9%E8%8A%B1%20%E4%BC%8A%E5%90%B9/%E6%B3%B3%E8%A3%85/skill_preview/PtZOdkZe95yCV3GCBBwQkfBcjAoZQgek.mp4",
