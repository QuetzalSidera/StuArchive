              "derived_skills": [],
              "info": [
                {
                  "cost": 1,
                  "describe": "从队伍中的STRIKER（突击）学生中指定两名为「朋友」，在本场战斗中本技能变为「选哪个好呢？」，并且立刻再次装填EX技能。<br> 伊吹（泳装）在「朋友」学生产生COST消耗时，获得3个「贝壳」，当「贝壳」累积到12个时，消耗全部「贝壳」并获得「贝壳之花」，之后不再获得「贝壳」"
                }
              ]
            },
            {
              "icon": "https://static.kivo.wiki/images/students/%E4%B8%B9%E8%8A%B1%20%E4%BC%8A%E5%90%B9/%E6%B3%B3%E8%A3%85/skill_icon/COCandPaNjThIvj2CzlrdDf93mgXVpCe.png",
              "title": "选哪个好呢？",
              "title_cn": "",
              "preview": "",
              "max_level": 5,
              "link_student_id": 0,
              "is_passive_skill": false,
              "derived_skills": [],
              "info": [
                {
                  "cost": 1,
                  "describe": "「朋友」学生的暴击伤害增加（持续一段时间）<br> 持有「贝壳之花」时，强化该技能，提升暴击伤害增加效果"
                }
              ]
            }
          ],
          "passive_skill": [
            {
              "icon": "https://static.kivo.wiki/images/students/%E4%B8%B9%E8%8A%B1%20%E4%BC%8A%E5%90%B9/%E6%B3%B3%E8%A3%85/skill_icon/LxsqKRLHzft4mdHqpYVtUeJuMpH0cSFM.png",
